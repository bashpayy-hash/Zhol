# zhol configuration - copy to .env and fill in. Never commit real secrets.
ZHOL_DB=data/zhol.db
ZHOL_TZ=Europe/Rome
# 1 = every alert waits for a person to approve it (pilot default)
ZHOL_REVIEW_ALERTS=1
# Protect write endpoints of the console/API with a shared token (sent as X-Zhol-Token)
ZHOL_ADMIN_TOKEN=

# Claude extraction of unstructured notices (falls back to rule-based extraction when unset)
ANTHROPIC_API_KEY=
ZHOL_LLM=auto
ZHOL_LLM_MODEL=claude-opus-5-5
ZHOL_LLM_EFFORT=low

# WhatsApp Business Cloud API (leave empty = console mode, nothing is sent)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_API_VERSION=v21.0
